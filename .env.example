# ── Required ──────────────────────────────────────────────────────────────────

# A strong random secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change_me_generate_with_openssl_rand_-hex_32

# Full public URL of your server (with https://)
BETTER_AUTH_URL=https://yourdomain.com

# A strong password for the PostgreSQL database user
POSTGRES_PASSWORD=change_me_strong_password

# ── Optional: Google OAuth ────────────────────────────────────────────────────
# Leave commented out to disable the "Continue with Google" button
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
